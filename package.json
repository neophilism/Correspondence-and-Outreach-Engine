{
  "name": "@accountability/correspondence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "default": "./dist/durable.js"
    },
    "./operator": {
      "types": "./dist/operator.d.ts",
      "default": "./dist/operator.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/validate-pr-registry.mjs && node scripts/verify-contracts.mjs && npm run test:package",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "dependencies": {
    "@accountability/evidence": "git+https://github.com/neophilism/Evidence-Storage-and-Provenance-Engine.git#dce7105a70b42d77afe4cd48d34723331447037c"
  }
}
